{
  "name": "@js-template-engine/core",
  "version": "2.3.0",
  "description": "Template engine core: processes data-defined component templates into HTML and CSS, and into React, Vue and Svelte through target extensions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./emitter": {
      "types": "./dist/emitter.d.ts",
      "import": "./dist/emitter.js",
      "require": "./dist/emitter.js"
    }
  },
  "typesVersions": {
    "*": {
      "emitter": [
        "./dist/emitter.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.type-check.json"
  },
  "dependencies": {
    "@js-template-engine/types": "workspace:^",
    "sass": "^1.101.0"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djurnamn/js-template-engine.git",
    "directory": "packages/core"
  },
  "keywords": [
    "js-template-engine",
    "core",
    "template",
    "engine",
    "html"
  ],
  "author": "Björn Djurnamn <bjorn@djurnamn.co>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/djurnamn/js-template-engine/issues"
  },
  "homepage": "https://github.com/djurnamn/js-template-engine/tree/main/packages/core",
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
